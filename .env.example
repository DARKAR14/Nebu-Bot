# Credenciales de la aplicación de Discord
DISCORD_TOKEN=

# ID numérico de la única cuenta autorizada para comandos dev
DEVELOPER_USER_ID=

# Gemini Live: crea la clave en Google AI Studio
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# MongoDB Atlas o una instancia MongoDB compatible
MONGODB_URI=
MONGODB_DB_NAME=nebu_bot

# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Entre 60 y 604800 segundos. Por defecto: 900 (15 minutos).
INVITE_MAX_AGE_SECONDS=900

# Render asigna PORT automáticamente. URL_PING debe apuntar al endpoint público /health.
PORT=3000
URL_PING=
