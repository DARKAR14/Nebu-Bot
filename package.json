{
  "name": "nebu-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Discord con comandos separados por nivel de acceso.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.18.0",
    "cloudinary": "^2.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
